{
  "name": "sku-vereinszentrale-api",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply vereinszentrale --remote",
    "db:migrate:local": "wrangler d1 migrations apply vereinszentrale --local",
    "db:backup": "wrangler d1 export vereinszentrale --remote --output=backup.sql"
  },
  "devDependencies": {
    "wrangler": "^4.165.0"
  }
}
